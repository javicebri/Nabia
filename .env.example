# Copy to ".env" in the project that USES Nabia (never commit ".env").
# Every variable is optional unless a provider says it needs a key.

# --- Shared HTTP / cache settings (NABIA_*) ---------------------------------
# NABIA_TIMEOUT_SECONDS=30
# NABIA_MAX_RETRIES=3
# NABIA_USER_AGENT=nabia/0.4.0
# NABIA_SSL_TRUST=system            # system | certifi
# NABIA_CACHE_ENABLED=false
# NABIA_CACHE_PATH=                 # default: per-user cache directory
# NABIA_CACHE_TTL_SECONDS=3600

# --- Open-Meteo (no key needed for non-commercial use) ----------------------
# NABIA_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# NABIA_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
